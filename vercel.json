{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd jarvis/frontend && npm run build",
  "outputDirectory": "jarvis/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
